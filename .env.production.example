# RealityCheck AI — production environment template for a single-host pilot.
#
# Copy this file to a private path outside the web root, for example:
#   /etc/realitycheck/production.env
# Set directory and file modes as documented in deploy/PILOT_RUNBOOK.md.
# Never commit the real production environment file.
#
# Variable names match backend/app/config.py (pydantic-settings field names).
# Values below are placeholders only. Replace every REPLACE_ME / CHANGE_ME
# before start. Placeholders are intentionally not usable production secrets.
#
# C2PA pilot boundary (Choice A): leave all C2PA trust variables unset.
# Do not enable trusted Content Credentials until a separately approved
# production trust-witness and root-control infrastructure exists.
# Empty or unset C2PA settings keep trust unavailable (technical/unavailable).
# Do not configure OS trust fallback or remote trust fetching.

REALITYCHECK_ENV=production
COOKIE_SECURE=true

# AUTH_SECRET must be generated on the production host and must be at least
# 32 characters (MIN_SECRET_LENGTH in backend/app/auth.py). The value below
# is deliberately shorter than 32 characters so production startup refuses it.
# Do not lengthen this placeholder — replace it entirely with a host-generated
# secret (see deploy/PILOT_RUNBOOK.md).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_ME

# Absolute path to a regular database file outside frontend/.
# Example only — adapt to the host layout.
LEDGER_PATH=/var/lib/realitycheck/ledger.sqlite

# IP address(es) of the reverse proxy as seen by Uvicorn (comma-separated).
# Hostnames and CIDR ranges are rejected. Add ::1 only if the proxy uses IPv6.
TRUSTED_PROXIES=127.0.0.1

# Provider API keys (never commit real values).
# CHANGE_ME is not a valid provider credential; replace before the smoke test.
OPENAI_API_KEY=CHANGE_ME
PARALLEL_API_KEY=CHANGE_ME

# Verified model and API base defaults from Settings.
OPENAI_MODEL_DEFAULT=gpt-4.1-mini
OPENAI_MODEL_COMPLEX=gpt-4.1
OPENAI_API_BASE=https://api.openai.com
PARALLEL_API_BASE=https://api.parallel.ai
PARALLEL_MCP_URL=https://search.parallel.ai/mcp

# Leave empty for same-origin serving behind the reverse proxy.
ALLOWED_ORIGINS=

# Session lifetime in seconds (default 12 hours).
SESSION_TTL_SECONDS=43200

# --- C2PA trust (Choice A: do not set these for the initial pilot) ---
# C2PA_TRUST_ROOT=
# C2PA_TRUST_STATE_PATH=
# C2PA_TRUST_PIN_PATH=
# C2PA_TRUST_CALLER_ID=
# C2PA_WITNESS_MAC_KEY=
# C2PA_ROOT_MAC_KEY=
